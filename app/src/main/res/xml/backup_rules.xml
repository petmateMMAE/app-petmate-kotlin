<?xml version="1.0" encoding="utf-8"?><!--
   Reglas de respaldo para Android 11 (API 30) y anterior (001/T-042, spec 002 G-05).
   minSdk es 24, asi que estos dispositivos siguen dentro del alcance de la app.

   En estas versiones android:allowBackup="false" ya apaga el respaldo completo, asi que
   hoy este archivo no cambia el comportamiento por si solo. Esta escrito para el dia en
   que alguien ponga allowBackup="true" sin pensar en lo que se lleva consigo: la exclusion
   ya esta puesta y ni el token de sesion ni la base de datos salen del telefono.

   Lo vigila BackupRulesSecurityTest.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
